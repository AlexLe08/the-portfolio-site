# Copy this file to .env for local development. .env itself is gitignored --
# never commit real secrets. In production, these are set as platform
# secrets instead.

# Local default is SQLite (see app/core/config.py) so you can omit this
# entirely to start. Uncomment to develop against the docker-compose Postgres:
# DATABASE_URL=postgresql+psycopg://postgres:devpassword@localhost:5432/portfolio

ADMIN_API_KEY=dev-only-change-me

# Admin UI login (POST /auth/login). Off until both are set. Make the hash with
# `./.venv/bin/python hash_password.py` and keep it in single quotes: it
# contains `$`. The secret signs session tokens: `openssl rand -hex 32`.
# ADMIN_PASSWORD_HASH='$argon2id$v=19$...'
# JWT_SECRET=
# ADMIN_SESSION_MINUTES=480
# LOGIN_RATE_LIMIT=5
# LOGIN_RATE_WINDOW_SECONDS=900

ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000

# Discord webhook URL for new contact-message notifications. Leave empty to
# turn notifications off. The URL is a secret: anyone who has it can post to
# the channel, so use a throwaway channel locally and never commit it.
DISCORD_WEBHOOK_URL=

# Email notification for new contact messages, sent through Resend's HTTP API
# (Render's free tier blocks outbound SMTP). Leave RESEND_API_KEY empty to turn
# it off. The key is a secret; never commit it. Without a verified Resend
# domain, NOTIFY_EMAIL_TO must be the address on your Resend account and
# EMAIL_FROM must stay on onboarding@resend.dev (the default).
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
# EMAIL_FROM=Portfolio Contact <onboarding@resend.dev>

# Contact form rate limit (defaults: 5 messages per hour per visitor). Behind a
# proxy, set CLIENT_IP_HEADER to the header the platform overwrites with the
# real client address; locally leave it empty. See docs/render-runbook.md.
# CLIENT_IP_HEADER=CF-Connecting-IP
# CONTACT_RATE_LIMIT=5
# CONTACT_RATE_WINDOW_SECONDS=3600

# Error reporting to Sentry (see app/core/monitoring.py). Leave empty to turn it
# off; locally you usually want it off. See docs/render-runbook.md for setup.
SENTRY_DSN=

# Media uploads to Cloudinary. Leave empty to turn uploads off. Copy the "API
# environment variable" from Cloudinary Console > Settings > API Keys and fill
# in the key and secret; the value must start with cloudinary:// (don't paste
# the CLOUDINARY_URL= prefix twice). The secret part is a secret; never commit it.
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
