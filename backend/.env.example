# Copy this file to .env for local development. .env itself is gitignored --
# never commit real secrets. In production, these are set as platform
# secrets instead.

# Local default is SQLite (see app/core/config.py) so you can omit this
# entirely to start. Uncomment to develop against the docker-compose Postgres:
# DATABASE_URL=postgresql+psycopg://postgres:devpassword@localhost:5432/portfolio

ADMIN_API_KEY=dev-only-change-me
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000

# Discord webhook URL for new contact-message notifications. Leave empty to
# turn notifications off. The URL is a secret: anyone who has it can post to
# the channel, so use a throwaway channel locally and never commit it.
DISCORD_WEBHOOK_URL=