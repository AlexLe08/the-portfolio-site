{
  "title": "Character sheet config",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "defaultJobId": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "slots": {
      "minItems": 1,
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 40,
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "description": "Stable id; jobs fill slots by this id."
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "description": "Shown under the square, e.g. \"Skills\"."
          },
          "side": {
            "type": "string",
            "enum": [
              "left",
              "right"
            ],
            "description": "Which column the slot sits in."
          },
          "icon": {
            "description": "Up to 4 characters drawn in the square. Defaults to the label's first two letters.",
            "type": "string",
            "minLength": 1,
            "maxLength": 4
          }
        },
        "required": [
          "id",
          "label",
          "side"
        ]
      }
    },
    "jobs": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 40,
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "description": "Used in the URL: ?job=<id>."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "description": "Short name for the job menu, e.g. \"Healthcare\"."
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "The panel heading, e.g. \"Developer in healthcare\"."
          },
          "level": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20,
                "description": "e.g. \"Lv.\" or \"Experience\"."
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              }
            },
            "required": [
              "label",
              "value"
            ]
          },
          "portrait": {
            "type": "object",
            "properties": {
              "src": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "description": "Any image URL: Cloudinary, a CMS asset, or a local path."
              },
              "alt": {
                "type": "string",
                "maxLength": 300
              },
              "width": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "height": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "framing": {
                "default": "face",
                "description": "face: a near-square head-and-shoulders frame. full: a tall full-body frame.",
                "type": "string",
                "enum": [
                  "face",
                  "full"
                ]
              }
            },
            "required": [
              "src",
              "alt"
            ]
          },
          "slots": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "maxLength": 40,
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "tooltip": {
                  "type": "object",
                  "properties": {
                    "title": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "subtitle": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    },
                    "items": {
                      "description": "Listed in order, most relevant first.",
                      "maxItems": 12,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                      }
                    },
                    "note": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 240
                    }
                  },
                  "required": [
                    "title"
                  ]
                },
                "action": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "anchor"
                        },
                        "target": {
                          "type": "string",
                          "maxLength": 40,
                          "pattern": "^[a-z0-9][a-z0-9-]*$",
                          "description": "Element id on the same page, without the #."
                        }
                      },
                      "required": [
                        "kind",
                        "target"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "link"
                        },
                        "href": {
                          "type": "string",
                          "maxLength": 300,
                          "pattern": "^\\/(?![/\\\\])",
                          "description": "A path on the same site."
                        }
                      },
                      "required": [
                        "kind",
                        "href"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "external"
                        },
                        "href": {
                          "type": "string",
                          "maxLength": 300,
                          "format": "uri"
                        },
                        "newTab": {
                          "description": "Open in a new tab. Off by default.",
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "kind",
                        "href"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "none"
                        }
                      },
                      "required": [
                        "kind"
                      ]
                    }
                  ]
                }
              },
              "required": [
                "tooltip",
                "action"
              ]
            },
            "description": "Content per slot id. A slot without an entry renders empty."
          },
          "sections": {
            "description": "Markdown per page section id. The host page renders these; the panel doesn't.",
            "type": "object",
            "propertyNames": {
              "type": "string",
              "maxLength": 40,
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            },
            "additionalProperties": {
              "type": "string",
              "maxLength": 10000
            }
          }
        },
        "required": [
          "id",
          "name",
          "title",
          "level",
          "slots"
        ]
      }
    }
  },
  "required": [
    "defaultJobId",
    "slots",
    "jobs"
  ]
}
