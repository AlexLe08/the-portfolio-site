{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint && npm --prefix ../packages/wol-character-panel run lint",
    "generate:types": "openapi-typescript ../backend/openapi.json -o lib/api-types.ts",
    "generate:character-schema": "npm --prefix ../packages/wol-character-panel run generate:schema && cp ../packages/wol-character-panel/character-sheet.schema.json ../backend/app/services/character_sheet.schema.json",
    "test": "vitest run && npm --prefix ../packages/wol-character-panel test",
    "test:smoke": "playwright test"
  },
  "dependencies": {
    "@solution-nine/wol-character-panel": "^1.0.0",
    "@sentry/nextjs": "^11.9.0",
    "next": "16.3.6",
    "openapi-fetch": "^0.17.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
